{
  "$schema": "./node_modules/stryker-mutator-core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "src/common/crypto/**/*.ts",
    "!src/common/crypto/**/*.spec.ts",
    "!src/common/crypto/*.module.ts",
    "src/modules/sweeps/**/*.ts",
    "!src/modules/sweeps/**/*.spec.ts",
    "!src/modules/sweeps/*.module.ts"
  ],
  "tsconfigFile": "tsconfig.json",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "config": "stryker-jest.config.js"
  },
  "coverageAnalysis": "perTest",
  "disableTypeChecks": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 55
  }
}
